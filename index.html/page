<script>
// ═══════════════════════════════════════════
// CONFIGURATION SUPABASE — À MODIFIER
// ═══════════════════════════════════════════
const SUPABASE_URL = 'https://supabase.com/dashboard/project/rmugngceojbarttctsoo';
const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJtdWduZ2Nlb2piYXJ0dGN0c29vIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg2MDE5NjIsImV4cCI6MjA5NDE3Nzk2Mn0.DAKlMEZ8B2QaWTzr1Y9Y_SeUWLdZIIa-CgfCh4RN3pc'; // ← REMPLACE PAR TA VRAIE CLÉ ANON

// ═══════════════════════════════════════════
// CRÉATION CLIENT SUPABASE
// ═══════════════════════════════════════════
const supa = window.supabase?.createClient(SUPABASE_URL, SUPABASE_KEY);

if (!supa) {
  console.warn('⚠️ Supabase non chargé. Vérifie la clé API.');
} else {
  console.log('✅ Supabase connecté — Tracking actif sur visitor_real');
}

// ═══════════════════════════════════════════
// FONCTION : ENVOYER VISITEUR
// ═══════════════════════════════════════════
async function trackVisitor() {
  if (!supa) return;

  const visitorData = {
    page: window.location.pathname || '/',
    referrer: document.referrer || 'direct',
    user_agent: navigator.userAgent || 'unknown',
    language: navigator.language || 'unknown',
    screen_resolution: `${window.screen.width}x${window.screen.height}`,
    time_on_page: 0
  };

  try {
    const { data, error } = await supa
      .from('visitor_real')
      .insert([visitorData])
      .select('id');

    if (error) {
      console.error('❌ Erreur tracking:', error.message);
      return null;
    }

    console.log('👤 Visiteur enregistré:', data[0]?.id);
    return data[0]?.id;
  } catch (e) {
    console.error('❌ Exception tracking:', e.message);
    return null;
  }
}

// ═══════════════════════════════════════════
// FONCTION : METTRE À JOUR TEMPS PASSÉ
// ═══════════════════════════════════════════
async function updateTimeOnPage(visitorId, seconds) {
  if (!supa || !visitorId) return;

  try {
    await supa
      .from('visitor_real')
      .update({ time_on_page: seconds })
      .eq('id', visitorId);
  } catch (e) {
    // Silencieux
  }
}

// ═══════════════════════════════════════════
// FONCTION : COMPTER VISITEURS EN LIGNE
// ═══════════════════════════════════════════
async function updateLiveCounter() {
  if (!supa) return;

  const fiveMinAgo = new Date(Date.now() - 5 * 60 * 1000).toISOString();

  try {
    const { count, error } = await supa
      .from('visitor_real')
      .select('*', { count: 'exact', head: true })
      .gte('created_at', fiveMinAgo);

    if (!error) {
      const liveCount = count || 0;
      // Mettre à jour le badge admin bar
      const elTop = document.getElementById('liveCountTop');
      if (elTop) elTop.textContent = liveCount;
      // Mettre à jour le compteur sidebar
      const elSidebar = document.getElementById('sidebarVisitorCount');
      if (elSidebar) elSidebar.textContent = liveCount;
    }
  } catch (e) {
    // Silencieux
  }
}

// ═══════════════════════════════════════════
// DÉMARRAGE DU TRACKING
// ═══════════════════════════════════════════
let visitorId = null;
const startTime = Date.now();

trackVisitor().then(id => {
  visitorId = id;
  updateLiveCounter();
});

// Mettre à jour le temps avant de quitter
window.addEventListener('beforeunload', () => {
  const timeSpent = Math.round((Date.now() - startTime) / 1000);
  if (visitorId) {
    // Utiliser sendBeacon pour être sûr que ça part
    const body = JSON.stringify({ time_on_page: timeSpent });
    navigator.sendBeacon?.(
      `${SUPABASE_URL}/rest/v1/visitor_real?id=eq.${visitorId}`,
      new Blob([body], { type: 'application/json' })
    );
  }
});

// Mettre à jour le compteur toutes les 30 secondes
setInterval(updateLiveCounter, 30000);

console.log('📊 ANKOAUTCA Tracking System — En écoute sur visitor_real');
</script>

