<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ANKOAUTCA — Notizie, Attualità, Mondo</title>
<meta name="description" content="ANKOAUTCA - Il portale italiano di notizie, attualità, politica, economia, sport, cultura e tecnologia.">
<meta name="robots" content="index, follow">
<meta property="og:title" content="ANKOAUTCA — Notizie dal Mondo">
<meta property="og:description" content="Il portale italiano di informazione. Notizie, attualità, analisi.">
<meta property="og:type" content="website">

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Source+Sans+3:wght@300;400;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

<!-- Tabler Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

<!-- Supabase -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root {
  --red: #C0121C;
  --red-dark: #8B0000;
  --red-light: #f8e8e8;
  --black: #0A0A0A;
  --dark: #1a1a1a;
  --gray-900: #222222;
  --gray-700: #444;
  --gray-500: #777;
  --gray-300: #ccc;
  --gray-100: #f4f4f2;
  --white: #ffffff;
  --cream: #faf9f7;
  --gold: #B8960C;
  --font-display: 'Playfair Display', Georgia, serif;
  --font-body: 'Source Sans 3', Arial, sans-serif;
  --font-serif: 'Source Serif 4', Georgia, serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: var(--font-body);
  background: var(--cream);
  color: var(--black);
  font-size: 16px;
  line-height: 1.6;
  overflow-x: hidden;
}

a { text-decoration: none; color: inherit; }
img { max-width: 100%; display: block; }

/* ============================
   TOP BAR
   ============================ */
.topbar {
  background: var(--black);
  color: var(--gray-300);
  font-size: 12px;
  padding: 6px 0;
  border-bottom: 2px solid var(--red);
}
.topbar-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}
.topbar-date { font-family: var(--font-serif); font-style: italic; color: #aaa; }
.topbar-links { display: flex; gap: 20px; align-items: center; }
.topbar-links a { color: #bbb; transition: color .2s; font-size: 11px; letter-spacing: .5px; text-transform: uppercase; }
.topbar-links a:hover { color: var(--red); }
.topbar-social { display: flex; gap: 14px; }
.topbar-social a { color: #888; font-size: 14px; transition: color .2s; }
.topbar-social a:hover { color: var(--red); }
.live-badge {
  background: var(--red);
  color: white;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  padding: 2px 7px;
  border-radius: 2px;
  text-transform: uppercase;
  animation: pulse 2s infinite;
}
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.7} }

/* ============================
   BREAKING NEWS TICKER
   ============================ */
.breaking-bar {
  background: var(--red);
  color: white;
  font-size: 13px;
  font-weight: 600;
  padding: 8px 0;
  overflow: hidden;
  display: flex;
  align-items: center;
}
.breaking-label {
  background: var(--black);
  color: white;
  padding: 0 16px;
  font-size: 11px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  white-space: nowrap;
  height: 100%;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.breaking-track {
  overflow: hidden;
  flex: 1;
  padding-left: 20px;
}
.breaking-inner {
  display: inline-flex;
  gap: 60px;
  animation: scrollTicker 40s linear infinite;
  white-space: nowrap;
}
.breaking-inner span::before { content: "●  "; opacity: .7; }
@keyframes scrollTicker { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

/* ============================
   HEADER / MASTHEAD
   ============================ */
header {
  background: var(--white);
  border-bottom: 3px solid var(--black);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 12px rgba(0,0,0,.08);
}
.masthead {
  max-width: 1280px;
  margin: 0 auto;
  padding: 16px 20px 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.logo-wrap { display: flex; flex-direction: column; align-items: flex-start; }
.logo-text {
  font-family: var(--font-display);
  font-size: 52px;
  font-weight: 900;
  letter-spacing: -2px;
  color: var(--black);
  line-height: 1;
  position: relative;
}
.logo-text .logo-a { color: var(--red); }
.logo-tagline {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 12px;
  color: var(--gray-500);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-top: 2px;
  padding-left: 2px;
}
.logo-rule {
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, var(--red), transparent);
  margin-top: 4px;
}
.header-actions { display: flex; align-items: center; gap: 12px; }
.search-box {
  display: flex;
  align-items: center;
  border: 1.5px solid var(--gray-300);
  border-radius: 3px;
  overflow: hidden;
  background: var(--gray-100);
}
.search-box input {
  border: none;
  background: transparent;
  padding: 7px 12px;
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--black);
  outline: none;
  width: 200px;
}
.search-box button {
  background: var(--red);
  border: none;
  color: white;
  padding: 8px 12px;
  cursor: pointer;
  font-size: 15px;
  transition: background .2s;
}
.search-box button:hover { background: var(--red-dark); }
.btn-abbonati {
  background: var(--red);
  color: white;
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 12px;
  letter-spacing: 1px;
  text-transform: uppercase;
  padding: 8px 18px;
  border: none;
  border-radius: 2px;
  cursor: pointer;
  transition: background .2s;
  white-space: nowrap;
}
.btn-abbonati:hover { background: var(--red-dark); }

/* ============================
   NAVIGATION
   ============================ */
nav.mainnav {
  background: var(--black);
}
.mainnav-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
  display: flex;
  align-items: center;
  gap: 0;
  overflow-x: auto;
  scrollbar-width: none;
}
.mainnav-inner::-webkit-scrollbar { display: none; }
.mainnav-inner a {
  color: #ddd;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  padding: 12px 16px;
  white-space: nowrap;
  transition: all .2s;
  border-bottom: 3px solid transparent;
  position: relative;
}
.mainnav-inner a:hover, .mainnav-inner a.active { color: white; border-bottom-color: var(--red); }
.mainnav-inner .nav-sep { color: #444; margin: 0 4px; user-select: none; }

/* ============================
   LAYOUT GRID
   ============================ */
.container { max-width: 1280px; margin: 0 auto; padding: 0 20px; }
.main-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 30px;
  padding: 30px 0;
}
@media (max-width: 900px) { .main-layout { grid-template-columns: 1fr; } }

/* ============================
   SECTION LABELS
   ============================ */
.section-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--black);
}
.section-label {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 700;
  color: var(--black);
  letter-spacing: -.3px;
}
.section-label-sm {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--gray-500);
}
.section-red-line {
  width: 40px;
  height: 3px;
  background: var(--red);
  border-radius: 2px;
}

/* ============================
   HERO — MAIN FEATURE
   ============================ */
.hero-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  grid-template-rows: auto auto;
  gap: 2px;
  background: var(--black);
  border: 2px solid var(--black);
  margin-bottom: 30px;
  border-radius: 2px;
  overflow: hidden;
}
.hero-main {
  grid-row: 1 / 3;
  position: relative;
  min-height: 480px;
  background: linear-gradient(160deg, #1a1a2e 0%, #16213e 100%);
  overflow: hidden;
  cursor: pointer;
}
.hero-main:hover .hero-main-img { transform: scale(1.03); }
.hero-main-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .6s ease;
  opacity: .75;
}
.hero-main-bg {
  position: absolute;
  inset: 0;
  background: url('https://picsum.photos/seed/news1/900/600') center/cover;
  opacity: .4;
  transition: transform .6s ease;
}
.hero-main:hover .hero-main-bg { transform: scale(1.03); }
.hero-main-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, rgba(0,0,0,.9) 0%, rgba(0,0,0,.3) 60%, transparent 100%);
}
.hero-main-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 28px;
  color: white;
}
.hero-category {
  display: inline-block;
  background: var(--red);
  color: white;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 3px 9px;
  margin-bottom: 10px;
  border-radius: 1px;
}
.hero-title {
  font-family: var(--font-display);
  font-size: 34px;
  font-weight: 900;
  line-height: 1.15;
  margin-bottom: 10px;
  color: white;
}
.hero-excerpt {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 15px;
  color: rgba(255,255,255,.8);
  line-height: 1.6;
  margin-bottom: 12px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hero-meta { font-size: 12px; color: rgba(255,255,255,.6); display: flex; gap: 14px; align-items: center; }
.hero-meta .author { font-weight: 600; color: rgba(255,255,255,.85); }

.hero-side {
  background: var(--black);
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.hero-side-item {
  position: relative;
  flex: 1;
  min-height: 180px;
  overflow: hidden;
  cursor: pointer;
}
.hero-side-item:hover .hsi-bg { transform: scale(1.05); }
.hsi-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  opacity: .5;
  transition: transform .4s ease;
}
.hsi-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, rgba(0,0,0,.85) 0%, transparent 60%);
}
.hsi-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 14px;
  color: white;
}
.hsi-cat {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--red);
  margin-bottom: 5px;
}
.hsi-title {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  line-height: 1.25;
  color: white;
}

/* ============================
   ARTICLE CARDS
   ============================ */
.articles-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-bottom: 30px;
}
@media(max-width:700px){ .articles-grid{grid-template-columns:1fr;} }

.card {
  background: var(--white);
  border: 1px solid #e8e6e1;
  border-radius: 2px;
  overflow: hidden;
  transition: transform .2s, box-shadow .2s;
  cursor: pointer;
}
.card:hover { transform: translateY(-3px); box-shadow: 0 6px 24px rgba(0,0,0,.1); }
.card-img {
  aspect-ratio: 16/9;
  background: var(--gray-100);
  overflow: hidden;
  position: relative;
}
.card-img img { width:100%; height:100%; object-fit:cover; transition: transform .4s; }
.card:hover .card-img img { transform: scale(1.05); }
.card-cat-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: var(--red);
  color: white;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 1px;
}
.card-body { padding: 16px; }
.card-title {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 8px;
  color: var(--black);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color .2s;
}
.card:hover .card-title { color: var(--red); }
.card-excerpt {
  font-size: 13.5px;
  color: var(--gray-500);
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12px;
  font-family: var(--font-serif);
  font-style: italic;
}
.card-meta { font-size: 11px; color: var(--gray-500); display: flex; justify-content: space-between; align-items: center; }
.card-author { font-weight: 600; color: var(--gray-700); }
.card-time { display: flex; align-items: center; gap: 4px; }

/* ============================
   LIST ARTICLE STYLE
   ============================ */
.article-list-item {
  display: flex;
  gap: 14px;
  padding: 14px 0;
  border-bottom: 1px solid #e8e6e1;
  cursor: pointer;
  transition: opacity .2s;
}
.article-list-item:last-child { border-bottom: none; }
.article-list-item:hover { opacity: .8; }
.ali-img {
  width: 90px;
  height: 68px;
  flex-shrink: 0;
  border-radius: 2px;
  overflow: hidden;
  background: var(--gray-100);
}
.ali-img img { width:100%; height:100%; object-fit:cover; }
.ali-content { flex: 1; min-width: 0; }
.ali-cat { font-size: 9px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--red); margin-bottom: 4px; }
.ali-title {
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--black);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ali-meta { font-size: 11px; color: var(--gray-500); margin-top: 5px; }

/* ============================
   OPINION / EDITORIALI
   ============================ */
.opinion-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 30px;
}
.opinion-card {
  background: var(--white);
  border: 1px solid #e8e6e1;
  padding: 20px;
  border-radius: 2px;
  position: relative;
  overflow: hidden;
}
.opinion-card::before {
  content: '"';
  font-family: var(--font-display);
  font-size: 120px;
  color: var(--red);
  opacity: .08;
  position: absolute;
  top: -20px;
  left: 10px;
  line-height: 1;
  pointer-events: none;
}
.opinion-author { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.opinion-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--gray-100);
  overflow: hidden;
  flex-shrink: 0;
  border: 2px solid var(--red);
}
.opinion-avatar img { width:100%; height:100%; object-fit:cover; }
.opinion-name { font-weight: 700; font-size: 14px; color: var(--black); }
.opinion-role { font-size: 11px; color: var(--gray-500); font-style: italic; }
.opinion-title {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  line-height: 1.35;
  color: var(--black);
  margin-bottom: 8px;
}
.opinion-excerpt { font-size: 13px; color: var(--gray-700); font-family: var(--font-serif); font-style: italic; line-height: 1.6; }

/* ============================
   SIDEBAR
   ============================ */
.sidebar { display: flex; flex-direction: column; gap: 26px; }

.widget {
  background: var(--white);
  border: 1px solid #e8e6e1;
  border-radius: 2px;
  overflow: hidden;
}
.widget-header {
  background: var(--black);
  color: white;
  padding: 10px 16px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
}
.widget-body { padding: 16px; }

.trending-item {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 10px 0;
  border-bottom: 1px solid #f0ede8;
  cursor: pointer;
}
.trending-item:last-child { border-bottom: none; padding-bottom: 0; }
.trending-num {
  font-family: var(--font-display);
  font-size: 28px;
  font-weight: 900;
  color: var(--gray-300);
  line-height: 1;
  min-width: 32px;
  transition: color .2s;
}
.trending-item:hover .trending-num { color: var(--red); }
.trending-text { flex: 1; }
.trending-cat { font-size: 9px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--red); margin-bottom: 3px; }
.trending-title { font-family: var(--font-display); font-size: 13.5px; font-weight: 700; line-height: 1.3; color: var(--black); }

/* Weather widget */
.weather-widget { text-align: center; padding: 20px 16px; }
.weather-city { font-size: 13px; font-weight: 700; color: var(--gray-700); letter-spacing: 1px; text-transform: uppercase; }
.weather-temp { font-family: var(--font-display); font-size: 52px; font-weight: 900; color: var(--black); line-height: 1; }
.weather-desc { font-style: italic; font-size: 13px; color: var(--gray-500); margin-top: 4px; }
.weather-icon { font-size: 36px; margin: 8px 0; }

/* Newsletter widget */
.newsletter-widget { padding: 20px 16px; }
.newsletter-title { font-family: var(--font-display); font-size: 18px; font-weight: 700; margin-bottom: 6px; }
.newsletter-sub { font-size: 13px; color: var(--gray-500); margin-bottom: 14px; line-height: 1.5; }
.newsletter-form { display: flex; flex-direction: column; gap: 8px; }
.newsletter-form input {
  border: 1.5px solid var(--gray-300);
  padding: 9px 12px;
  font-family: var(--font-body);
  font-size: 13px;
  border-radius: 2px;
  outline: none;
  transition: border-color .2s;
}
.newsletter-form input:focus { border-color: var(--red); }
.newsletter-form button {
  background: var(--red);
  color: white;
  border: none;
  padding: 10px;
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 12px;
  letter-spacing: 1px;
  text-transform: uppercase;
  border-radius: 2px;
  cursor: pointer;
  transition: background .2s;
}
.newsletter-form button:hover { background: var(--red-dark); }

/* Social stats */
.social-stats { display: flex; flex-direction: column; gap: 0; }
.social-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 16px;
  border-bottom: 1px solid #f0ede8;
  cursor: pointer;
  transition: background .15s;
}
.social-item:last-child { border-bottom: none; }
.social-item:hover { background: var(--gray-100); }
.social-icon { font-size: 20px; width: 34px; height: 34px; display:flex; align-items:center; justify-content:center; border-radius: 4px; }
.social-fb { background: #1877F2; color: white; }
.social-tw { background: #000; color: white; }
.social-ig { background: linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); color:white; }
.social-yt { background: #FF0000; color: white; }
.social-tg { background: #0088cc; color: white; }
.social-name { font-weight: 700; font-size: 13px; flex: 1; }
.social-count { font-family: var(--font-display); font-size: 15px; font-weight: 700; color: var(--gray-700); }
.social-label { font-size: 10px; color: var(--gray-500); }

/* ============================
   CATEGORY SECTIONS
   ============================ */
.category-section { margin-bottom: 36px; }
.category-two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
@media(max-width:600px){ .category-two-col{grid-template-columns:1fr;} }

/* Big article horizontal */
.big-article-horiz {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  background: var(--black);
  border-radius: 2px;
  overflow: hidden;
  min-height: 240px;
  margin-bottom: 20px;
  cursor: pointer;
}
.bah-img {
  overflow: hidden;
}
.bah-img img { width:100%; height:100%; object-fit:cover; transition:transform .4s; }
.big-article-horiz:hover .bah-img img { transform: scale(1.04); }
.bah-content {
  padding: 24px;
  background: var(--black);
  color: white;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
